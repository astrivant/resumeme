{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resumeme config",
  "type": "object",
  "properties": {
    "awareness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "allowed_actors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(\\[bot\\])?$"
          },
          "default": []
        }
      }
    },
    "appendices": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "awareness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "figures": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "knowledge-usage": {
                  "type": "boolean",
                  "default": false
                },
                "knowledge-map": {
                  "type": "boolean",
                  "default": false
                },
                "decision-influences": {
                  "type": "boolean",
                  "default": false
                },
                "knowledge-hierarchy": {
                  "type": "boolean",
                  "default": false
                },
                "toolbox-use": {
                  "type": "boolean",
                  "default": false
                },
                "problem-repertoire": {
                  "type": "boolean",
                  "default": false
                },
                "checkpoint-transitions": {
                  "type": "boolean",
                  "default": false
                },
                "checkpoint-comparisons": {
                  "type": "boolean",
                  "default": false
                }
              }
            },
            "include": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "id": {
                    "enum": [
                      "knowledge-usage",
                      "knowledge-map",
                      "decision-influences",
                      "knowledge-hierarchy",
                      "toolbox-use",
                      "problem-repertoire",
                      "checkpoint-transitions",
                      "checkpoint-comparisons"
                    ]
                  },
                  "group": {
                    "enum": [
                      "knowledge",
                      "life",
                      "repertoire",
                      "checkpoints"
                    ]
                  }
                }
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "id": {
                    "enum": [
                      "knowledge-usage",
                      "knowledge-map",
                      "decision-influences",
                      "knowledge-hierarchy",
                      "toolbox-use",
                      "problem-repertoire",
                      "checkpoint-transitions",
                      "checkpoint-comparisons"
                    ]
                  },
                  "group": {
                    "enum": [
                      "knowledge",
                      "life",
                      "repertoire",
                      "checkpoints"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
          "default": "ERROR",
          "description": "Minimum severity for OpenTelemetry JSON logs on stdout; RESUMEME_LOG_LEVEL and --log-level override it."
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linkedin"],
      "description": "Profile identity and the captured sections selected for the document.",
      "properties": {
        "linkedin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["username"],
          "properties": {
            "username": {"$ref": "#/properties/linkedin/properties/username"}
          }
        },
        "github": {"$ref": "#/properties/github"},
        "sections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "order": {"$ref": "#/properties/section_order"},
            "experience": {"$ref": "#/properties/experience"},
            "education": {"$ref": "#/properties/education"},
            "projects": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source_url_filter": {"$ref": "#/properties/project_filter"},
                "include": {"$ref": "#/properties/projects/properties/include"},
                "exclude": {"$ref": "#/properties/projects/properties/exclude"}
              }
            }
          }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "description": "Resume compilation inputs, output paths, and visual presentation.",
      "properties": {
        "output": {"$ref": "#/properties/output"},
        "style": {"$ref": "#/properties/style"},
        "appendices": {"$ref": "#/properties/appendices"},
        "template": {"$ref": "#/properties/template"}
      }
    },
    "publishing": {
      "type": "object",
      "additionalProperties": false,
      "description": "External publication targets and release follow-up actions.",
      "properties": {
        "linkedin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resume": {"$ref": "#/properties/linkedin/properties/resume"},
            "ownership": {"$ref": "#/properties/linkedin/properties/ownership"}
          }
        },
        "readme": {"$ref": "#/properties/readme"},
        "pages": {"$ref": "#/properties/pages"}
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional AI-assisted generation and employer-specific resume variants.",
      "properties": {
        "awareness": {"$ref": "#/properties/awareness"},
        "codex": {"$ref": "#/properties/codex"}
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "path": {
          "type": "string",
          "pattern": "^/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*$",
          "not": {"pattern": "\\s"},
          "default": "/",
          "description": "Directory within the Pages site, including leading/trailing slashes; / serves index.html at the root."
        },
        "custom_domain": {
          "type": ["string", "null"],
          "format": "hostname",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?\\.[A-Za-z]{2,63}$",
          "default": null,
          "description": "Expected hostname already configured in GitHub Settings > Pages; null accepts the configured host."
        }
      }
    },
    "readme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["auto", "project", "resume"],
          "default": "auto",
          "description": "Auto generates a personal README on GitHub forks; project preserves it; resume always generates."
        },
        "convergence_plot": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9_./-]+\\.svg$",
          "default": "docs/assets/capture-convergence.svg",
          "description": "Tag-generated Matplotlib SVG and adjacent JSON history; null disables publication."
        },
        "introduction": {
          "type": ["string", "null"],
          "pattern": "\\S",
          "default": null,
          "description": "Optional plain-text introduction for the personal README."
        },
        "output": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+\\.md$",
          "default": "README.md",
          "description": "Repository-relative Markdown destination; links are relative to this file."
        }
      }
    },
    "linkedin": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9_-]{1,99}|(?:https?://|//)?(?:(?:www|[a-z]{2})\\.)?linkedin\\.com/in/[A-Za-z0-9][A-Za-z0-9_-]{1,99}/?(?:[?#][^\\s]*)?)$",
          "description": "Public profile username or LinkedIn /in/ URL; normalized to the username when loaded. Login credentials belong in environment variables."
        },
        "resume": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publish": {
              "type": "boolean",
              "default": false,
              "description": "Upload the verified signed tag release PDF to LinkedIn's saved application resumes."
            },
            "replace_existing": {
              "type": "boolean",
              "default": false,
              "description": "After confirming the new PDF is saved, delete every other saved LinkedIn resume; false retains them."
            },
            "share_with_recruiters": {
              "type": ["boolean", "null"],
              "default": null,
              "description": "Override Share resume data with recruiters after a confirmed upload; null preserves the account setting. Requires resume.publish for live changes."
            }
          }
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "update_about": {
              "type": "boolean",
              "default": false
            },
            "repository": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+$"
            },
            "releases_url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri",
              "pattern": "^https://[^\\s]+$"
            }
          }
        }
      },
      "required": [
        "username"
      ],
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "properties": {
        "sharding": {
          "type": "object",
          "additionalProperties": false,
          "description": "Adaptive worker count from complete traversal timings; disabled uses the initial count.",
          "properties": {
            "enabled": {"type": "boolean", "default": true},
            "initial": {"type": "integer", "minimum": 1, "maximum": 12, "default": 6},
            "minimum": {"type": "integer", "minimum": 1, "maximum": 12, "default": 2},
            "maximum": {"type": "integer", "minimum": 1, "maximum": 12, "default": 8},
            "cooldown_runs": {"type": "integer", "minimum": 1, "maximum": 20, "default": 3}
          }
        },
        "browser": {
          "type": "string",
          "enum": ["firefox", "chrome"],
          "default": "firefox",
          "description": "Selenium browser for profile capture and live About updates. Each browser retains its own local login profile."
        },
        "page_timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 180
        },
        "app_approval_timeout_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 900,
          "default": 900,
          "description": "Headless wait for app approval and unknown checkpoints. Code-entry MFA and CAPTCHA fail immediately; zero disables waiting."
        },
        "max_scrolls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_pages_per_section": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "fetch_link_previews": {
          "type": "boolean"
        },
        "retry_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "retry_backoff_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "retry_max_backoff_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "assets": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "tex": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        "pdf": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_./-]+$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "paper": {
          "enum": [
            "a4",
            "letter"
          ]
        },
        "accent": {
          "description": "Six-digit hexadecimal hyperlink color.",
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$"
        },
        "theme": {
          "description": "Optional key in style.themes; null leaves the base style unchanged.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "background": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$"
        },
        "about_background": {
          "description": "Optional six-digit hexadecimal About panel color, without #; null leaves About unshaded.",
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{6}$",
          "default": null
        },
        "line_height": {
          "description": "Body-text baseline spacing multiplier relative to the font's normal line height.",
          "type": "number",
          "minimum": 1,
          "maximum": 2,
          "default": 1
        },
        "paragraph_spacing": {
          "description": "Space between body paragraphs in points; independent of section and heading spacing.",
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "default": 3
        },
        "about_text_indent": {
          "description": "Left inset for About body text in points; the section heading remains at the normal margin.",
          "type": "number",
          "minimum": 0,
          "maximum": 24,
          "default": 8
        },
        "font_size": {
          "enum": [
            10,
            11,
            12
          ]
        },
        "show_header_photo": {
          "description": "Display the cover/background photo independently of the profile portrait and section images.",
          "type": "boolean"
        },
        "display_profile_photo": {
          "description": "Display the profile portrait independently of the cover photo and section images.",
          "type": "boolean",
          "default": true
        },
        "display_location": {
          "description": "Display the owner's profile location and labeled Address fields; employment locations remain visible.",
          "type": "boolean",
          "default": true
        },
        "show_table_of_contents": {
          "description": "Link visible sections below the LinkedIn profile link in the first-page identity column; enabled by default.",
          "type": "boolean",
          "default": true
        },
        "highlight_job_subheadings": {
          "description": "Emphasize standalone labels in experience.subheadings; false retains their text without highlighting.",
          "type": "boolean",
          "default": true
        },
        "skills_word_cloud": {
          "description": "Display the top 20 skills weighted by references plus twice each endorsement; disable skills to hide the cloud.",
          "type": "boolean"
        },
        "skills_allow_vertical": {
          "description": "Allow vertical labels alongside horizontal labels in the skill cloud.",
          "type": "boolean",
          "default": false
        },
        "skills_size_legend": {
          "description": "Show small, medium, and large character examples beneath the skill cloud's endorsement color scale.",
          "type": "boolean",
          "default": false
        },
        "ink": {
          "description": "Body text color.",
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$"
        },
        "name_color": {
          "description": "Profile name color.",
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$"
        },
        "heading_color": {
          "description": "Section heading color.",
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$"
        },
        "entry_color": {
          "description": "Entry heading color.",
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$"
        },
        "company_font_size": {
          "type": "integer",
          "minimum": 10,
          "maximum": 20,
          "default": 13,
          "description": "Bold company name size in points across employer rows, profile branding, and project affiliations."
        },
        "company_color": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{6}$",
          "default": "191919",
          "description": "Company name color, including clickable company names; other links use accent."
        },
        "skill_colors": {
          "description": "Ordered hexadecimal color stops from zero to maximum displayed endorsements; one stop gives a uniform color.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{6}$"
          }
        },
        "themes": {
          "description": "Inline partial style overrides; selected theme fields take precedence over base values.",
          "type": "object",
          "propertyNames": {
            "pattern": "\\S"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "paper": {
                "$ref": "#/properties/style/properties/paper"
              },
              "accent": {
                "$ref": "#/properties/style/properties/accent"
              },
              "background": {
                "$ref": "#/properties/style/properties/background"
              },
              "about_background": {
                "$ref": "#/properties/style/properties/about_background"
              },
              "line_height": {
                "$ref": "#/properties/style/properties/line_height"
              },
              "paragraph_spacing": {
                "$ref": "#/properties/style/properties/paragraph_spacing"
              },
              "about_text_indent": {
                "$ref": "#/properties/style/properties/about_text_indent"
              },
              "font_size": {
                "$ref": "#/properties/style/properties/font_size"
              },
              "show_header_photo": {
                "$ref": "#/properties/style/properties/show_header_photo"
              },
              "display_profile_photo": {
                "$ref": "#/properties/style/properties/display_profile_photo"
              },
              "display_location": {
                "$ref": "#/properties/style/properties/display_location"
              },
              "show_table_of_contents": {
                "$ref": "#/properties/style/properties/show_table_of_contents"
              },
              "highlight_job_subheadings": {
                "$ref": "#/properties/style/properties/highlight_job_subheadings"
              },
              "skills_word_cloud": {
                "$ref": "#/properties/style/properties/skills_word_cloud"
              },
              "skills_allow_vertical": {
                "$ref": "#/properties/style/properties/skills_allow_vertical"
              },
              "skills_size_legend": {
                "$ref": "#/properties/style/properties/skills_size_legend"
              },
              "ink": {
                "$ref": "#/properties/style/properties/ink"
              },
              "name_color": {
                "$ref": "#/properties/style/properties/name_color"
              },
              "heading_color": {
                "$ref": "#/properties/style/properties/heading_color"
              },
              "entry_color": {
                "$ref": "#/properties/style/properties/entry_color"
              },
              "company_font_size": {
                "$ref": "#/properties/style/properties/company_font_size"
              },
              "company_color": {
                "$ref": "#/properties/style/properties/company_color"
              },
              "skill_colors": {
                "$ref": "#/properties/style/properties/skill_colors"
              },
              "show_connection_count": {
                "$ref": "#/properties/style/properties/show_connection_count"
              },
              "show_connection_link": {
                "$ref": "#/properties/style/properties/show_connection_link"
              },
              "display_birthday": {
                "$ref": "#/properties/style/properties/display_birthday"
              },
              "display_websites": {
                "$ref": "#/properties/style/properties/display_websites"
              },
              "display_phone": {
                "$ref": "#/properties/style/properties/display_phone"
              },
              "website_icon": {
                "$ref": "#/properties/style/properties/website_icon"
              },
              "show_headline": {
                "$ref": "#/properties/style/properties/show_headline"
              },
              "display_current_position": {
                "$ref": "#/properties/style/properties/display_current_position"
              },
              "profile_column_side": {
                "$ref": "#/properties/style/properties/profile_column_side"
              },
              "profile_column_wrap": {
                "$ref": "#/properties/style/properties/profile_column_wrap"
              },
              "later_page_body_width": {
                "$ref": "#/properties/style/properties/later_page_body_width"
              },
              "first_page_body_width": {
                "$ref": "#/properties/style/properties/first_page_body_width"
              },
              "figure_caption_width": {
                "$ref": "#/properties/style/properties/figure_caption_width"
              },
              "figure_caption_alignment": {
                "$ref": "#/properties/style/properties/figure_caption_alignment"
              },
              "text_wrap_width": {
                "$ref": "#/properties/style/properties/text_wrap_width"
              },
              "profile_column_text_wrap_width": {
                "$ref": "#/properties/style/properties/profile_column_text_wrap_width"
              }
            },
            "additionalProperties": false
          }
        },
        "show_connection_count": {
          "description": "Display the captured connection count once below the LinkedIn profile link.",
          "type": "boolean"
        },
        "show_connection_link": {
          "description": "Link to the captured connections page, using the count or a concise Connections label.",
          "type": "boolean"
        },
        "display_birthday": {
          "description": "Display the birthday field when contact information is enabled; hidden by default.",
          "type": "boolean",
          "default": false
        },
        "display_websites": {
          "description": "Display captured Website fields in Contact; hidden by default. Social links remain independent.",
          "type": "boolean",
          "default": false
        },
        "display_phone": {
          "description": "Display captured Phone fields in Contact; email remains available and phone visibility is independent of websites.",
          "type": "boolean",
          "default": true
        },
        "website_icon": {
          "description": "Optional local raster path or direct public HTTP(S) image/favicon URL; normalized to PNG for LaTeX.",
          "anyOf": [
            {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_./-]+$"},
            {"type": "string", "format": "uri", "pattern": "^https?://[^\\s]+$"},
            {"type": "null"}
          ],
          "default": null
        },
        "show_headline": {
          "type": "boolean",
          "default": false,
          "description": "Display the captured or generated headline beneath the portrait; hidden by default."
        },
        "display_current_position": {
          "type": ["boolean", "null"],
          "default": null,
          "description": "Sidebar company, logo, and title: null selects the latest visible Experience role, true selects the latest captured role regardless of filters, false hides it."
        },
        "profile_column_side": {
          "description": "First-page profile placement in a separate left or right column; profile_column_wrap optionally permits body text below a right-side profile.",
          "enum": [
            "left",
            "right"
          ],
          "default": "left"
        },
        "profile_column_wrap": {
          "description": "Allow body text to expand below the right-side profile; false keeps separate first-page columns. Ignored when profile_column_side is left.",
          "type": "boolean",
          "default": false
        },
        "later_page_body_width": {
          "description": "Maximum body-text width on page 2 onward, as a fraction of the available text area after indentation. Independent of first_page_body_width; 1 uses all available width.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.9
        },
        "first_page_body_width": {
          "description": "Maximum body-text width on page 1, including About and Experience, as a fraction of their available column width after indentation. Does not resize the identity sidebar; 1 uses all available width.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 1
        },
        "text_wrap_width": {
          "$ref": "#/properties/style/properties/later_page_body_width",
          "deprecated": true,
          "description": "Legacy alias for later_page_body_width. Do not specify both names in the same mapping."
        },
        "figure_caption_width": {
          "description": "Width of the centered figure-caption block as a fraction of available page width. Independent of body-text widths; 1 uses all available width.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.8
        },
        "figure_caption_alignment": {
          "description": "Alignment of the figure number, title, and description within their centered caption block.",
          "type": "string",
          "enum": ["left", "center", "right"],
          "default": "center"
        },
        "profile_column_text_wrap_width": {
          "$ref": "#/properties/style/properties/first_page_body_width",
          "deprecated": true,
          "description": "Legacy alias for first_page_body_width. Do not specify both names in the same mapping."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "template": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_./-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "experience": {
      "description": "Filter displayed jobs without altering the captured snapshot.",
      "type": "object",
      "properties": {
        "reflow_soft_breaks": {
          "description": "Reflow soft line breaks within job prose and bullets; false preserves captured line boundaries.",
          "type": "boolean",
          "default": true
        },
        "subheadings": {
          "description": "Complete standalone job labels, matched without case, excess whitespace, or a trailing colon. Replaces defaults; [] disables recognition.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^\\r\\n\\u2028\\u2029]*\\S[^\\r\\n\\u2028\\u2029]*$"
          },
          "default": [
            "Responsibilities",
            "Key responsibilities",
            "Technologies",
            "Projects",
            "Skills",
            "Achievements",
            "Key achievements",
            "Accomplishments",
            "Highlights",
            "Summary",
            "Duties"
          ]
        },
        "disable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "company": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "minProperties": 1,
            "additionalProperties": false
          }
        },
        "last_years": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9999,
          "description": "Include employment overlapping the trailing calendar-year window when since is null; null leaves the start unrestricted."
        },
        "since": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "default": null,
          "description": "Inclusive fixed start date, such as '2020-06-01'; overrides last_years when set and must not follow as_of."
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Quoted ISO date anchoring the window; null uses the current UTC date."
        }
      },
      "additionalProperties": false
    },
    "education": {
      "description": "Filter displayed schools and qualifications without altering the captured snapshot.",
      "type": "object",
      "properties": {
        "disable": {
          "description": "Exclude an entry when all fields of any selector match. Matches ignore case, repeated whitespace, and typographic apostrophes.",
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "school": {
                "type": "string",
                "pattern": "\\S"
              },
              "degree": {
                "type": "string",
                "pattern": "\\S"
              },
              "major": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "minProperties": 1,
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "github": {
      "type": "object",
      "properties": {
        "username": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
          "description": "Public GitHub username, or null to omit the header link."
        },
        "contributions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "months": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12,
              "default": 1,
              "description": "Trailing calendar months, inclusive of both endpoints."
            },
            "placement": {
              "type": "string",
              "enum": ["profile", "appendix"],
              "default": "profile"
            },
            "as_of": {
              "type": ["string", "null"],
              "format": "date",
              "default": null,
              "description": "Quoted ISO end date; null uses today's UTC date."
            }
          }
        }
      },
      "additionalProperties": false
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean", "default": false},
            "publish": {"type": "boolean", "default": false},
            "max_skills": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20},
            "context": {"type": "string", "maxLength": 20000, "default": ""}
          }
        },
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "context": {
          "type": "string",
          "maxLength": 20000
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "reasoning_effort": {
          "type": ["string", "null"],
          "enum": [null, "none", "minimal", "low", "medium", "high", "xhigh", "max"],
          "default": null,
          "description": "Codex reasoning effort override; null uses the CLI default. Supported levels depend on the selected model."
        },
        "about_max_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "headline_max_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "companies": {
          "type": "array",
          "default": [],
          "maxItems": 255,
          "items": {
            "type": "object",
            "required": [
              "username",
              "job_url"
            ],
            "additionalProperties": false,
            "properties": {
              "username": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,99}$"
              },
              "job_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^\\s]+$",
                "maxLength": 2048
              },
              "context": {
                "type": "string",
                "maxLength": 20000
              },
              "company_context": {
                "type": "string",
                "maxLength": 40000
              },
              "job_context": {
                "type": "string",
                "maxLength": 40000
              },
              "overrides": {
                "type": "object",
                "default": {},
                "additionalProperties": false,
                "description": "Partial per-job config: mappings merge recursively; lists, scalars, and null replace inherited values. Capture identity, publication, and output paths remain shared or matrix-owned.",
                "properties": {
                  "profile": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Partial profile selection overrides; identity and LinkedIn login settings remain global.",
                    "properties": {
                      "github": {"$ref": "#/properties/github"},
                      "sections": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "order": {"$ref": "#/properties/section_order"},
                          "experience": {"$ref": "#/properties/experience"},
                          "education": {"$ref": "#/properties/education"},
                          "projects": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "source_url_filter": {"$ref": "#/properties/project_filter"},
                              "include": {"$ref": "#/properties/projects/properties/include"},
                              "exclude": {"$ref": "#/properties/projects/properties/exclude"}
                            }
                          }
                        }
                      }
                    }
                  },
                  "document": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Partial document presentation overrides; output paths remain matrix-owned.",
                    "properties": {
                      "style": {"$ref": "#/properties/style"},
                      "appendices": {"$ref": "#/properties/appendices"},
                      "template": {"$ref": "#/properties/template"}
                    }
                  },
                  "automation": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "codex": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "context": {"$ref": "#/properties/codex/properties/context"},
                          "model": {"$ref": "#/properties/codex/properties/model"},
                          "reasoning_effort": {"$ref": "#/properties/codex/properties/reasoning_effort"},
                          "about_max_words": {"$ref": "#/properties/codex/properties/about_max_words"},
                          "headline_max_words": {"$ref": "#/properties/codex/properties/headline_max_words"}
                        }
                      }
                    }
                  },
                  "appendices": {"$ref": "#/properties/appendices"},
                  "style": {"$ref": "#/properties/style"},
                  "section_order": {"$ref": "#/properties/section_order"},
                  "experience": {"$ref": "#/properties/experience"},
                  "education": {"$ref": "#/properties/education"},
                  "projects": {"$ref": "#/properties/projects"},
                  "project_filter": {"$ref": "#/properties/project_filter"},
                  "appendices": {"$ref": "#/properties/appendices"},
                  "template": {"$ref": "#/properties/template"},
                  "github": {"$ref": "#/properties/github"},
                  "capture": {"$ref": "#/properties/capture"},
                  "codex": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "context": {"$ref": "#/properties/codex/properties/context"},
                      "model": {"$ref": "#/properties/codex/properties/model"},
                      "reasoning_effort": {"$ref": "#/properties/codex/properties/reasoning_effort"},
                      "about_max_words": {"$ref": "#/properties/codex/properties/about_max_words"},
                      "headline_max_words": {"$ref": "#/properties/codex/properties/headline_max_words"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": ["array", "null"],
          "default": null,
          "description": "Project filters by name, affiliation, or both. Null keeps all projects; [] selects none. The source URL filter still applies.",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "pattern": "\\S"},
              "affiliation": {"type": "string", "pattern": "\\S"}
            }
          }
        },
        "exclude": {
          "type": "array",
          "default": [],
          "description": "Project filters by name, affiliation, or both to omit after consolidation. Exclusions override include; [] excludes nothing.",
          "items": {"$ref": "#/properties/projects/properties/include/items"}
        }
      }
    },
    "project_filter": {
      "description": "Python regex searched against resolved project source URLs, falling back to captured URLs. Null includes all projects, including unlinked entries.",
      "type": [
        "string",
        "null"
      ],
      "format": "regex",
      "default": "(?i)^https?://(?:www\\.)?github\\.com(?:[/?#]|$)"
    },
    "section_order": {
      "description": "Enabled section keys in PDF and contents order. Comment out or remove a key to hide it; an empty array renders only the profile header.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "default": [
        "contact",
        "about",
        "featured",
        "activity",
        "experience",
        "education",
        "services",
        "career-breaks",
        "certifications",
        "volunteering-experiences",
        "projects",
        "publications",
        "patents",
        "courses",
        "honors",
        "test-scores",
        "skills",
        "recommendations",
        "languages",
        "organizations",
        "interests",
        "causes"
      ]
    }
  },
  "anyOf": [
    {"required": ["linkedin"]},
    {"required": ["profile"]}
  ],
  "additionalProperties": false
}
